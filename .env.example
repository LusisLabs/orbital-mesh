# Copy to .env and adjust. Docker Compose reads MESH_PUBLISH_PORT from the host environment.

# --- Control plane HTTP ---
MESH_SERVER_HOST=0.0.0.0
MESH_SERVER_PORT=8787
MESH_ENVIRONMENT=production
MESH_PUBLISH_PORT=8787

# --- Static UI (Vite build output); in Docker this is set in the image ---
MESH_WEB_ASSET_PATH=web/dist

# --- Persistence ---
MESH_STATE_DIRECTORY=.mesh-runtime-state
MESH_VAULT_PATH=.mesh-runtime-state/vault
MESH_INTEGRATIONS_CONFIG_PATH=.mesh-runtime-state/integrations.json

# --- Defaults ---
MESH_DEFAULT_STEERING_MODE=approval_gate
MESH_DEFAULT_OPERATOR_PAUSE_POINT=evaluation_ready
MESH_EVALUATION_MODE=native
MESH_ORCHESTRATION_MODE=native

# --- Production hardening ---
MESH_MAX_JSON_BODY_BYTES=1048576
MESH_SECURITY_HEADERS=true
MESH_ACCESS_LOG=1

# --- GitNexus sidecar ---
# Docker Compose defines a `gitnexus` service; keep autostart off and use the URL:
MESH_GITNEXUS_DISABLE_AUTOSTART=1
MESH_GITNEXUS_SIDECAR_URL=http://gitnexus:4747
# Native / host-only Python (no Compose): run GitNexus in another terminal, then:
# MESH_GITNEXUS_SIDECAR_URL=http://127.0.0.1:4747
# Published GitNexus port on the host (Compose):
GITNEXUS_PUBLISH_PORT=4747
# Only if you start the CLI yourself instead of Compose (advanced):
# MESH_GITNEXUS_SIDECAR_COMMAND=

# --- Optional CLI integrations ---
# Promptfoo is installed in the default mesh Docker image; leave unset to use PATH.
# MESH_PROMPTFOO_COMMAND=
# Goose CLI is not bundled (install on the host or extend the image). Example:
# MESH_GOOSE_COMMAND=/usr/local/bin/goose
# Orchestrator subprocess budget for the Python goose bridge (must be > inner Goose run timeout):
# MESH_GOOSE_BRIDGE_TIMEOUT_SECONDS=180
# Per-invocation timeout for `goose run` inside goose_bridge (healthcheck, execution review, etc.):
# MESH_GOOSE_RUN_TIMEOUT_SECONDS=60
