# Copy to .env and adjust. Docker Compose reads MESH_PUBLISH_PORT from the host environment.

# --- Control plane HTTP ---
MESH_SERVER_HOST=0.0.0.0
MESH_SERVER_PORT=8787
MESH_ENVIRONMENT=production
MESH_PUBLISH_PORT=8787

# --- Static UI (meshapp static export); in Docker this is set in the image ---
MESH_WEB_ASSET_PATH=meshapp/frontend/out

# --- Persistence (relative paths are resolved from the repository root, not the shell cwd) ---
MESH_STATE_BACKEND=file
MESH_DATABASE_URL=postgresql://mesh:mesh@postgres:5432/mesh
MESH_MEMORY_GRAPH_BACKEND=local
# MESH_MEMORY_GRAPH_BACKEND=helix
# MESH_HELIX_API_ENDPOINT=http://localhost:6969
# MESH_HELIX_PORT=6969
# MESH_HELIX_QUERY_NAMESPACE=mesh
MESH_STATE_DIRECTORY=.mesh-runtime-state
MESH_RESEARCH_DIRECTORY=.mesh-runtime-state/research
MESH_VAULT_PATH=.mesh-runtime-state/vault
MESH_INTEGRATIONS_CONFIG_PATH=.mesh-runtime-state/integrations.json

# --- Product app identity and teams ---
# proxy_header keeps external authenticated ingress as the identity source.
# app_session enables /api/auth/* email/OAuth sessions and team-scoped dashboards.
MESH_AUTH_MODE=proxy_header
MESH_OPERATOR_IDENTITY_PATH=.mesh-runtime-state/operator-identity.json
MESH_SESSION_COOKIE_NAME=mesh_session
# MESH_AUTH_ALLOWED_ORIGINS=https://mesh.example.com
MESH_SIGNUP_ENABLED=1
MESH_PASSWORD_AUTH_ENABLED=1
# Non-local app_session signup requires a real captcha provider.
# MESH_CAPTCHA_PROVIDER=turnstile
# MESH_CAPTCHA_SITE_KEY=
# MESH_CAPTCHA_SECRET_KEY=
# Local development only:
# MESH_CAPTCHA_DEV_BYPASS=1
# MESH_GOOGLE_OAUTH_CLIENT_ID=
# MESH_GOOGLE_OAUTH_CLIENT_SECRET=
# MESH_GOOGLE_OAUTH_REDIRECT_URL=https://mesh.example.com/api/auth/oauth/google/callback
# MESH_GITHUB_OAUTH_CLIENT_ID=
# MESH_GITHUB_OAUTH_CLIENT_SECRET=
# MESH_GITHUB_OAUTH_REDIRECT_URL=https://mesh.example.com/api/auth/oauth/github/callback

# --- Defaults ---
MESH_DEFAULT_STEERING_MODE=approval_gate
MESH_DEFAULT_OPERATOR_PAUSE_POINT=evaluation_ready
MESH_EVALUATION_MODE=native
MESH_ORCHESTRATION_MODE=native
MESH_AGENT_FABRIC_MODE=native
MESH_STRUCTURED_LOGS=1
MESH_BUILD_VERSION=dev
# Release handoff sets this for pilot/prod runtime binding.
# MESH_BUILD_COMMIT=<git commit from release provenance packet>
# Back-compat aliases read by /api/health when MESH_BUILD_* is unset:
# MESH_IMAGE_TAG=dev
# GIT_COMMIT=unknown
MESH_FEATURE_FLAG_CREDENTIALS_AVAILABLE=true
MESH_INCIDENT_CREDENTIALS_AVAILABLE=true
MESH_AUDIT_LOGGING_AVAILABLE=true
MESH_MAX_TRANSIENT_RETRIES=2
MESH_MAX_RETRY_WINDOW_SECONDS=60

# --- Production hardening ---
MESH_MAX_JSON_BODY_BYTES=1048576
MESH_AUTHENTICATED_INGRESS_PROOF_PATH=.mesh-runtime-state/authenticated-ingress-deployment-proof.json
MESH_DESIGN_PARTNER_PACKET_PATH=.mesh-runtime-state/design-partner-packet.json
MESH_BACKUP_RESTORE_REHEARSAL_PATH=.mesh-runtime-state/backup-restore-rehearsal.json
MESH_LOAD_CONCURRENCY_REHEARSAL_PATH=.mesh-runtime-state/load-concurrency-rehearsal.json
# Versioned org/infra + model-provider policy used for topology-aware agent routing.
# The profile records model/provider names and secret env-var references only; raw keys remain outside artifacts.
MESH_ORCHESTRATION_TOPOLOGY_PROFILE_PATH=config/orchestration-topology.profile.json
MESH_ORCHESTRATION_TOPOLOGY_DRILL_PATH=.mesh-runtime-state/orchestration-topology-drill.json
# MESH_POLICY_SIGNING_KEY_PATH=/run/secrets/mesh-policy-signing-key
# MESH_POLICY_SIGNING_KEY=<target HMAC key from secret manager>
# MESH_BRAIN_ARTIFACT_URI_PREFIX=s3://mesh-prod-artifacts/mesh-brain
MESH_BRAIN_ARTIFACT_REGISTRY_PATH=.mesh-runtime-state/artifacts.json
MESH_BRAIN_ARTIFACT_UPLOAD_PROOF_PATH=.mesh-runtime-state/mesh-brain-artifact-upload-proof.json
# MESH_BRAIN_SERVING_BASE_URL=https://mesh-brain-serving.example.internal/v1
# MESH_BRAIN_SERVING_MODEL=nvidia/nemotron-3-nano-4b
MESH_RUN_EXPORT_RETENTION_DAYS=30
MESH_RUN_EXPORT_RETENTION_REVIEWED=0
MESH_RELEASE_PROVENANCE_PATH=.mesh-runtime-state/release-provenance.json
# MESH_BUILD_IMAGE_DIGEST=sha256:<release image digest>
MESH_ON_CALL_DRILL_PATH=.mesh-runtime-state/on-call-drill.json
# Required before external audit sink compliance reliance.
# MESH_AUDIT_SINK_PROOF_PATH=.mesh-runtime-state/audit-sink-proof.json
# MESH_AUDIT_SINK_CERTIFICATION_PATH=.mesh-runtime-state/audit-sink-certification.json
# Required only if production feature-flag or incident-provider credentials are enabled.
# MESH_FEATURE_FLAG_PROVIDER_PROOF_PATH=.mesh-runtime-state/feature-flag-provider-proof.json
# MESH_INCIDENT_PROVIDER_PROOF_PATH=.mesh-runtime-state/incident-provider-proof.json
MESH_PROCUREMENT_SECURITY_PACKAGE_PATH=config/procurement-security.package.json
MESH_PUBLIC_PROOF_PACKAGE_PATH=config/public-proof.package.json
# Per-command steering payload cap (override_decision / override_execution_parameters / attach_note).
# MESH_MAX_STEERING_PAYLOAD_BYTES=65536
MESH_SECURITY_HEADERS=true
MESH_ACCESS_LOG=1

# --- OpenTelemetry consumer ---
# Enable the OTLP/HTTP metrics receiver at POST /v1/metrics. When set, an OTel
# Collector (or any OTLP producer) can push metric payloads that Mesh turns into
# runs automatically. The receiver is opt-in because it has no auth beyond the
# optional bearer token below — put it behind a reverse proxy before exposing it.
# MESH_OTEL_RECEIVER_ENABLED=1
# MESH_OTEL_RECEIVER_TOKEN=

# Prometheus (or PromQL-compatible OTel collector endpoint) for the pull ingester
# and for Prometheus-backed feedback observations. Leave unset to keep feedback
# on its stub-observation path.
# MESH_PROMETHEUS_URL=http://prometheus:9090
# MESH_PROMETHEUS_QUERY_TIMEOUT_SECONDS=10
# MESH_FEEDBACK_PROMETHEUS_ENABLED=1

# --- Layer 3: LLM decision fallback ---
# When an OTel signal doesn't match any metric-action rule, ask the LLM (via the
# Goose bridge) to propose a bounded action from the allowlist. Failures fall
# through to escalate — the rule engine coverage is never degraded by an LLM
# outage. Cost/latency matter here: expect 5-30s added to unmatched-signal runs.
# MESH_LLM_DECISION_FALLBACK_ENABLED=1
# MESH_LLM_DECISION_FALLBACK_TIMEOUT_SECONDS=30

# --- Layer 4: Learn rules from operator overrides ---
# Capture every override_decision and override_execution_parameters event and
# synthesize candidate rules when N operators have made the same override with
# successful outcomes. Suggestions surface at GET /api/rules/suggestions — they
# never auto-apply. An operator reviews, copies into the policy file, restarts.
# MESH_RULE_LEARNING_ENABLED=1
# MESH_RULE_LEARNING_MIN_OBSERVATIONS=5
# MESH_RULE_LEARNING_MAX_AGE_DAYS=30

# --- Bare-metal SSH actuation (Solana, geth, reth, lighthouse, etc.) ---
# For blockchain nodes that run on dedicated hardware, not in Kubernetes.
# The SSH adapter has four overlapping safety constraints: the enable flag,
# the host allowlist, the service allowlist, and a hardcoded verb allowlist
# inside the adapter (only systemctl restart/start/stop/status are allowed).
# ALL must be set before any real SSH fires.
# MESH_SSH_EXECUTION_ENABLED=1
# MESH_SSH_COMMAND=ssh
# MESH_SSH_IDENTITY_FILE=/etc/mesh/id_ed25519
# MESH_SSH_CONNECT_TIMEOUT_SECONDS=10
# MESH_SSH_COMMAND_TIMEOUT_SECONDS=30
# Keepalive probes detect a silently-dropped TCP flow within
# (interval * count_max) seconds. Default 30 * 3 = 90s. Without these,
# a mid-command partition could hang for the OS-level TCP retransmit
# timeout (~15 min on Linux).
# MESH_SSH_SERVER_ALIVE_INTERVAL_SECONDS=30
# MESH_SSH_SERVER_ALIVE_COUNT_MAX=3
# MESH_SSH_ALLOWED_HOSTS=vault-prod-07,vault-prod-08,eth-archival-02
# MESH_SSH_ALLOWED_SERVICES=solana-validator.service,geth.service,reth.service
# Optional: node targets for the bare-metal signal ingester. JSON array of
# {"name", "kind": "solana"|"geth"|"reth", "rpc_url", "host", "service"}.
# MESH_BARE_METAL_NODE_TARGETS=[{"name":"vault-prod-07","kind":"solana","rpc_url":"http://127.0.0.1:8899","host":"vault-prod-07","service":"solana-validator.service"}]

# --- GitNexus sidecar ---
# Docker Compose no longer builds GitNexus by default.
# Point mesh at an existing GitNexus instance if you want that integration:
MESH_GITNEXUS_DISABLE_AUTOSTART=1
MESH_GITNEXUS_SIDECAR_URL=http://host.docker.internal:4747
# Native / host-only Python (no Compose): use:
# MESH_GITNEXUS_SIDECAR_URL=http://127.0.0.1:4747
# If you do not want GitNexus at all, leave the value blank in your local .env.
# MESH_GITNEXUS_SIDECAR_URL=
# Only if you start the CLI yourself instead of Compose (advanced):
# MESH_GITNEXUS_SIDECAR_COMMAND=

# --- Optional CLI integrations ---
# Promptfoo is installed in the default mesh Docker image; leave unset to use PATH.
# MESH_READINESS_PROBE_TIMEOUT_SECONDS=15
# MESH_PROMPTFOO_COMMAND=promptfoo
# Native mesh_eval uses the Rust LatentMAS tokenizer probe in the stack image.
# Configure one tokenizer backend, or leave both unset for the explicit heuristic fallback.
# MESH_EVAL_CONTEXT_TOKEN_BUDGET=2048
# MESH_EVAL_TOKENIZER_JSON=
# MESH_EVAL_SENTENCEPIECE_MODEL=
# MESH_EVAL_LATENTMAS_COMMAND=latentmas
# MESH_EVAL_LATENTMAS_TIMEOUT_SECONDS=30
# Deep Agents proposal fabric is disabled by default. When enabled, Mesh uses the vendored
# deepagents source to generate proposal-lane attempts inside a bounded sandbox workspace.
# This does not grant Deep Agents direct Mesh actuation, production Kubernetes access, or
# real repo writes.
# MESH_AGENT_FABRIC_MODE=deepagents
# MESH_DEEPAGENTS_MODEL=openai:MiniMax-M2.7
# MESH_DEEPAGENTS_TIMEOUT_SECONDS=120
# MESH_AGENT_TASK_TIMEOUT_SECONDS=180
# MESH_DEEPAGENTS_WORKSPACE_ROOT=.mesh-runtime-state/deepagents
# MESH_DEEPAGENTS_MAX_ARTIFACT_CHARS=20000
# LatentMAS full inference is disabled by default because it requires a PyTorch/Hugging Face
# runtime and usually a GPU. Enable only when the sidecar is running.
# Local sidecar profile:
# docker compose -f docker-compose.yml -f docker-compose.latentmas.yml --profile latentmas up --build
# MESH_LATENTMAS_ENABLED=1
# MESH_LATENTMAS_URL=http://127.0.0.1:8791
# MESH_LATENTMAS_TIMEOUT_SECONDS=600
# MESH_LATENTMAS_MODEL_NAME=Qwen/Qwen3-4B
# MESH_LATENTMAS_DEVICE=cuda
# MESH_LATENTMAS_PROMPT_MODE=sequential
# MESH_LATENTMAS_LATENT_STEPS=10
# MESH_LATENTMAS_MAX_NEW_TOKENS=1024
# MESH_LATENTMAS_USE_VLLM=0
# MESH_LATENTMAS_MAX_ARTIFACT_CHARS=20000
# Hermes is bundled in the default/prod mesh image. The all-in-one stack can
# override this with a dedicated sidecar and docker-exec command.
# MESH_HERMES_COMMAND=hermes
# MESH_HERMES_COMMAND_TIMEOUT_SECONDS=180
# HERMES_AGENT_REF=1525624904159e7c2d6ac3feef951e27ad0d23bb
# UV_VERSION=0.11.6
# GOOSE_VERSION=v1.30.0
# All-in-one stack sidecar overrides:
# HERMES_RUNTIME_IMAGE=mesh-intelligence-hermes:dev
# Goose CLI is bundled in the default mesh Docker image.
# MESH_GOOSE_COMMAND=goose
# Legacy config key still read by RuntimeConfig:
# MESH_GOOSE_TIMEOUT_SECONDS=180
# MESH_GOOSE_COMMAND_TIMEOUT_SECONDS=180
# Kubernetes execution stays mock-only unless you opt into live kubectl actuation.
# Recommended for local e2e only: constrain both context and namespace.
# MESH_KUBERNETES_LIVE_EXECUTION_ENABLED=1
# MESH_KUBECTL_COMMAND=kubectl
# MESH_KUBERNETES_ROLLOUT_TIMEOUT_SECONDS=120
# MESH_KUBERNETES_ALLOWED_CONTEXTS=k3d-mesh-e2e
# MESH_KUBERNETES_ALLOWED_NAMESPACES=search
# Default `docker compose` mesh service mounts `${HOME}/.kube/config` at `/root/.kube/config` (read-only).
# Override the host path when your kubeconfig lives elsewhere (CI, rootless Docker, etc.).
# MESH_KUBECONFIG_HOST_PATH=/path/to/kubeconfig
# Production compose requires this path and refuses to start without allowed contexts/namespaces:
# MESH_KUBECONFIG_HOST_PATH=/etc/mesh/kubeconfig
# MESH_KUBERNETES_ALLOWED_CONTEXTS=prod-us-east-1
# MESH_KUBERNETES_ALLOWED_NAMESPACES=mesh-targets
# Docker-native local e2e uses `docker compose -f docker-compose.yml -f docker-compose.e2e.yml`
# plus the helper scripts under `scripts/` to generate a container-safe kubeconfig automatically.
# One-command all-in-one stack. This defaults to DeepAgents plus the CPU LatentMAS sidecar.
# docker compose -f docker-compose.stack.yml up --build
# Full context: docs/all-in-one-compose-stack.md
# Optional GPU lane:
# MESH_LATENTMAS_DOCKERFILE=Dockerfile.latentmas MESH_LATENTMAS_DEVICE=cuda docker compose -f docker-compose.stack.yml -f docker-compose.latentmas-nvidia.yml up --build
#
# Apple Silicon / Docker Desktop (no NVIDIA, no Metal inside Linux containers): use the CPU image and device.
# Metal/MPS only works for LatentMAS when you run it on the macOS host, not inside Docker.
#   MESH_LATENTMAS_DOCKERFILE=Dockerfile.latentmas.cpu
#   MESH_LATENTMAS_DEVICE=cpu
# Then either export those before `docker compose ...` or add them to this file.
#
# Native macOS LatentMAS with Metal (MPS): install PyTorch for Mac, then from repo root:
#   export MESH_LATENTMAS_DEVICE=mps
#   python -m services.orchestrator.latentmas_server
# Point the stack at the host: MESH_STACK_LATENTMAS_URL=http://host.docker.internal:8791 (and omit the latentmas service
# or disable the profile and run Mesh without the sidecar container).
#
# Linux + NVIDIA GPU + CUDA image: add `docker-compose.latentmas-nvidia.yml` and use Dockerfile.latentmas + MESH_LATENTMAS_DEVICE=cuda.
# MESH_STACK_KUBE_CONTEXT=mesh-compose
# MESH_STACK_NAMESPACE=search
# MESH_STACK_DEPLOYMENT=semantic-search
# MESH_STACK_MULTI_ALLOWED_CONTEXTS=mesh-compose,mesh-compose-vm,mesh-compose-baremetal
# MESH_STACK_ALLOWED_NAMESPACES=search
# MESH_STACK_AGENT_FABRIC_MODE=deepagents
# MESH_STACK_AGENT_OPERATOR_ENABLED=1
# MESH_AGENT_OPERATOR_PRIORITY=hermes,goose,codex,claudecode,openclaw,temporal,kubernetes,n8n,latentmas
# MESH_AGENT_MESH_AGENTS=goose,hermes,codex,claudecode,openclaw,airflow,temporal,dagster,prefect,flyte,luigi,oozie,kubernetes,n8n
# MESH_AGENT_OPERATOR_CONFIDENCE_FLOOR=0.86
# MESH_AGENT_OPERATOR_AUTONOMY_TIER=escalated
# MESH_AGENT_OPERATOR_EXISTING_RUN_MAX_AGE_SECONDS=3600
# MESH_STACK_HERMES_EXEC_COMMAND=docker exec -w /workspace/mesh-intel -e HERMES_HOME=/workspace/mesh-intel/.hermes-local mesh-intel-hermes-stack /opt/venv/bin/hermes
# Optional external GitNexus sidecar. docker-compose.stack.yml does not start GitNexus by default.
# MESH_STACK_GITNEXUS_URL=http://host.docker.internal:4747
# MESH_STACK_ENABLE_LATENTMAS=1
# MESH_STACK_LATENTMAS_URL=http://latentmas:8791
# MESH_LATENTMAS_MODEL_NAME=sshleifer/tiny-gpt2
# MESH_EXPECT_MESH_EVAL_TOKENIZER_PROBE=1
# MESH_STACK_SMOKE_EVALUATION_MODE=native
# MESH_STACK_SMOKE_ORCHESTRATION_MODE=native
# MESH_STACK_SMOKE_STEERING_MODE=interruptible_auto
# MESH_K3S_API_PUBLISH_PORT=6443
# MESH_POSTGRES_PUBLISH_PORT=5432
# MESH_POSTGRES_DB=mesh
# MESH_POSTGRES_USER=mesh
# MESH_POSTGRES_PASSWORD=mesh
# MESH_LATENTMAS_PUBLISH_PORT=8791
# MESH_DOCKER_SOCKET_HOST_PATH=/var/run/docker.sock
# Back-compat alias for command timeout:
# MESH_GOOSE_BRIDGE_TIMEOUT_SECONDS=180
# Optional fixed timeout for `goose run` calls inside goose_bridge.
# If unset, provider-specific GOOSE_* timeouts below apply.
# MESH_GOOSE_RUN_TIMEOUT_SECONDS=60
# MESH_HERMES_RUN_TIMEOUT_SECONDS=180
# Enable AI-authored vault insights and proof docs after a run completes.
# MESH_VAULT_AI_POSTPROCESS_ENABLED=1
# Optional Goose provider settings for containerized runs.
# Recommended: use the MiniMax OpenAI-compatible route. Compose uses namespaced
# provider overrides so stray host GOOSE_PROVIDER=ollama values are not inherited.
# MESH_COMPOSE_HERMES_INFERENCE_PROVIDER=openai
# MESH_COMPOSE_HERMES_MODEL=MiniMax-M2.7
# MESH_COMPOSE_LLM_MODEL=MiniMax-M2.7
# MESH_COMPOSE_GOOSE_PROVIDER=openai
# MESH_COMPOSE_GOOSE_MODEL=MiniMax-M2.5
# MESH_COMPOSE_GOOSE_FALLBACK_PROVIDER=
# MESH_COMPOSE_GOOSE_FALLBACK_MODEL=MiniMax-M2.5
# Bare-metal equivalents:
# HERMES_INFERENCE_PROVIDER=openai
# HERMES_MODEL=MiniMax-M2.7
# HERMES_FALLBACK_MODEL=MiniMax-M2.7
# LLM_MODEL=MiniMax-M2.7
# GOOSE_PROVIDER=openai
# GOOSE_MODEL=MiniMax-M2.5
# GOOSE_PRIMARY_TIMEOUT_SECONDS=60
# GOOSE_OLLAMA_TIMEOUT_SECONDS=45
# GOOSE_FALLBACK_TIMEOUT_SECONDS=90
# OPENAI_BASE_URL=https://api.minimax.io/v1
# OPENAI_API_KEY=
# MINIMAX_API_KEY=
# Optional: model for MiniMax OpenAI-compatible API (Goose bridge + goose-autoresearch MiniMax runner).
# MINIMAX_MODEL=MiniMax-M2.7
# MiniMax multi-wave research uses only MINIMAX_MODEL (or MINIMAX_DEFAULT_MODEL / default MiniMax-M2.5); it does not
# inherit GOOSE_MODEL / HERMES_MODEL (often Ollama tags), which MiniMax rejects with HTTP 400 unknown model.
# Long MiniMax HTTP reads (multi-wave research): default 600s; wave3 uses max(this, 900s) unless overridden.
# MINIMAX_CHAT_TIMEOUT_SECONDS=600
# MESH_MINIMAX_TIMEOUT_SECONDS=600
# MINIMAX_WAVE3_TIMEOUT_SECONDS=1200
# ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
# ANTHROPIC_API_KEY=
# Used by Goose + `run_minimax_research.py` when OPENAI_API_KEY is unset (Anthropic-compatible MiniMax).
# ANTHROPIC_AUTH_TOKEN=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# Optional explicit local-provider override only:
# MESH_COMPOSE_GOOSE_PROVIDER=ollama
# MESH_COMPOSE_GOOSE_MODEL=gemma4:31b-it-q4_K_M
# MESH_COMPOSE_OLLAMA_HOST=http://host.docker.internal:11434
# Bare-metal equivalents:
# GOOSE_PROVIDER=ollama
# GOOSE_MODEL=gemma4:31b-it-q4_K_M
# OLLAMA_HOST=http://127.0.0.1:11434

# --- Container workspace ---
# Docker Compose mounts this repository at /workspace/mesh-intelligence inside the mesh container.
# For repo-patch flows, use repo paths inside the container namespace, for example:
# /workspace/mesh-intelligence/fixtures/codebases/search_service
