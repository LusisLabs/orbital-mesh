  "sections": [
    {
      "section_id": "sso_identity",
      "status": "ready",
      "required_before": "pilot",
      "owner": "platform-security",
      "summary": "SSO/OIDC/SAML deployment evidence, proxy identity headers, role mapping, and raw-upstream isolation are documented and tied to deployed ingress proof verification.",
      "artifact_refs": [
        "docs/authenticated-ingress.md",
        "control_plane_server.py",
        "scripts/verify_authenticated_ingress.py",
        "scripts/verify_authenticated_ingress_deployment.py"
      ],
      "verification_commands": [
        "scripts/verify_authenticated_ingress.py --json",
        "scripts/verify_authenticated_ingress_deployment.py --proof \"$MESH_AUTHENTICATED_INGRESS_PROOF_PATH\" --json"
      ],
      "external_evidence_required": true
    },
    {
      "section_id": "audit_export",
      "status": "ready",
      "required_before": "expansion",
      "owner": "platform-security",
      "summary": "Run export, archive retrieval, durable upload proof, external audit-sink proof, and redaction boundaries are documented and verified by repository-local commands.",
      "artifact_refs": [
        "docs/security-audit-readiness.md",
        "docs/pilot-slo-error-budget.md",
        "scripts/verify_run_export_retrieval.py",
        "scripts/verify_run_export_upload.py",
        "scripts/verify_audit_sink_contract.py"
      ],
      "verification_commands": [
        "scripts/verify_run_export_retrieval.py --package <path> --archive <path> --json",
        "scripts/verify_run_export_upload.py --package <path> --archive <path> --proof <path> --json",
        "scripts/verify_audit_sink_contract.py --proof \"$MESH_AUDIT_SINK_PROOF_PATH\" --json"
      ],
      "external_evidence_required": true
    },
    {
      "section_id": "retention_controls",
      "status": "ready",
      "required_before": "pilot",
      "owner": "platform-security",
      "summary": "Retention, redaction, deletion-control, and secret-export policy coverage is documented for signals, logs, traces, model outputs, audit proof, run exports, and training candidates.",
      "artifact_refs": [
        "config/data-classification.policy.json",
        "shared/mesh_runtime/data_classification.py",
        "scripts/verify_data_classification_policy.py",
        "docs/pilot-slo-error-budget.md"
      ],
      "verification_commands": [
        "scripts/verify_data_classification_policy.py --json"
