{
  "openapi": "3.1.0",
  "info": {
    "title": "Praxis Demo Orders API",
    "version": "2026-05-20"
  },
  "paths": {
    "/orders": {
      "get": {
        "operationId": "listOrders",
        "summary": "List redacted order summaries",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/orders/{order_id}/cancel": {
      "post": {
        "operationId": "cancelOrder",
        "summary": "Cancel an order after operator review",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  }
}
