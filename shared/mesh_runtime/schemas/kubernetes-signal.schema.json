{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesh.local/contracts/kubernetes-signal.schema.json",
  "title": "KubernetesDeploymentSignal",
  "type": "object",
  "required": [
    "signal_type",
    "signal_id",
    "observed_at",
    "environment",
    "cluster",
    "namespace",
    "service",
    "deployment",
    "pods",
    "events",
    "logs"
  ],
  "properties": {
    "signal_type": {
      "type": "string",
      "enum": [
        "kubernetes_deployment_issue"
      ]
    },
    "signal_id": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "string"
    },
    "cluster": {
      "type": "string"
    },
    "namespace": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "deployment": {
      "type": "object",
      "required": [
        "name",
        "revision",
        "image",
        "rollout_started_at",
        "rollout_status",
        "desired_replicas",
        "updated_replicas",
        "available_replicas"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "rollout_started_at": {
          "type": "string",
          "format": "date-time"
        },
        "rollout_status": {
          "type": "string",
          "enum": [
            "healthy",
            "progressing",
            "degraded",
            "failed"
          ]
        },
        "desired_replicas": {
          "type": "integer"
        },
        "updated_replicas": {
          "type": "integer"
        },
        "available_replicas": {
          "type": "integer"
        },
        "last_deploy_timestamp": {
          "type": ["string", "null"],
          "description": "RFC3339 timestamp of the deployment's most recent rollout (mirrors rollout_started_at)."
        },
        "seconds_since_deploy": {
          "type": ["integer", "null"],
          "description": "Wall-clock age of the most recent deploy. Used by the decision engine for SRE-grade deploy correlation: a crash within ~30min of a deploy strongly suggests the deploy is the cause."
        }
      },
      "additionalProperties": false
    },
    "pods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "phase",
          "ready",
          "restarts",
          "container_status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "ready": {
            "type": "boolean"
          },
          "restarts": {
            "type": "integer"
          },
          "container_status": {
            "type": "string"
          },
          "last_state_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reason",
          "message",
          "count",
          "type"
        ],
        "properties": {
          "reason": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "type": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "logs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pod",
          "container",
          "stream",
          "message"
        ],
        "properties": {
          "pod": {
            "type": "string"
          },
          "container": {
            "type": "string"
          },
          "stream": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "related_context": {
      "type": "object"
    },
    "post_action_observations": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
