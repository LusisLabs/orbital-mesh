{
  "title": "RecursiveChaosCyclePacket",
  "type": "object",
  "required": [
    "schema_version",
    "cycle_id",
    "manifest_id",
    "profile_id",
    "run_id",
    "decision_id",
    "started_at",
    "completed_at",
    "recursion_depth",
    "selected_experiment",
    "target",
    "pre_state_ref",
    "fault_state_ref",
    "mesh_observation",
    "safety_verdict",
    "recovery_packet_id",
    "learning_packet_id",
    "evidence_refs",
    "sealed"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "enum": ["mesh.recursive_chaos.cycle_packet.v1"]},
    "cycle_id": {"type": "string"},
    "manifest_id": {"type": "string"},
    "profile_id": {"type": "string"},
    "run_id": {"type": "string"},
    "decision_id": {"type": ["string", "null"]},
    "started_at": {"type": "string"},
    "completed_at": {"type": "string"},
    "recursion_depth": {"type": "integer"},
    "selected_experiment": {"type": "object"},
    "target": {"type": "object"},
    "pre_state_ref": {"type": "string"},
    "fault_state_ref": {"type": "string"},
    "mesh_observation": {"type": "object"},
    "safety_verdict": {
      "type": "object",
      "required": ["safety_class", "mutation_allowed", "forbidden_actions_enforced"],
      "additionalProperties": false,
      "properties": {
        "safety_class": {
          "type": "string",
          "enum": ["local_disposable", "staging_owned", "production_probe_only", "production_mutating_blocked"]
        },
        "mutation_allowed": {"type": "boolean"},
        "forbidden_actions_enforced": {"type": "boolean"}
      }
    },
    "recovery_packet_id": {"type": ["string", "null"]},
    "learning_packet_id": {"type": ["string", "null"]},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "sealed": {"type": "boolean"}
  }
}
