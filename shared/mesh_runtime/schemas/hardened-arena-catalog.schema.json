{
  "title": "HardenedArenaCatalog",
  "type": "object",
  "required": ["schema_version", "provider", "source", "imported_at", "claim_status", "deployment_claim", "production_readiness_claim", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "enum": ["mesh.hardened_arena.catalog.v1"]},
    "provider": {"type": "string"},
    "source": {"type": "string"},
    "imported_at": {"type": "string"},
    "claim_status": {"type": "string", "enum": ["catalog_data_only"]},
    "deployment_claim": {"type": "boolean"},
    "production_readiness_claim": {"type": "boolean"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "provider",
          "slug",
          "display_name",
          "type",
          "os",
          "architecture",
          "compliance_labels",
          "tool_list",
          "chart_dependencies",
          "version_family",
          "source_url",
          "source_ref",
          "imported_at",
          "proof_placeholders"
        ],
        "additionalProperties": false,
        "properties": {
          "provider": {"type": "string"},
          "slug": {"type": "string"},
          "display_name": {"type": "string"},
          "type": {"type": "string", "enum": ["image", "chart"]},
          "os": {"type": "array", "items": {"type": "string"}},
          "architecture": {"type": "array", "items": {"type": "string"}},
          "compliance_labels": {"type": "array", "items": {"type": "string"}},
          "tool_list": {"type": "array", "items": {"type": "string"}},
          "chart_dependencies": {"type": "array", "items": {"type": "string"}},
          "version_family": {"type": ["string", "null"]},
          "source_url": {"type": "string"},
          "source_ref": {"type": "string"},
          "imported_at": {"type": "string"},
          "proof_placeholders": {
            "type": "object",
            "required": ["digest_ref", "sbom_ref", "provenance_ref", "vulnerability_scan_ref", "attestation_refs", "observed_evidence", "blockers"],
            "additionalProperties": false,
            "properties": {
              "digest_ref": {"type": ["string", "null"]},
              "sbom_ref": {"type": ["string", "null"]},
              "provenance_ref": {"type": ["string", "null"]},
              "vulnerability_scan_ref": {"type": ["string", "null"]},
              "attestation_refs": {"type": "array", "items": {"type": "string"}},
              "observed_evidence": {"type": "array", "items": {"type": "string"}},
              "blockers": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
