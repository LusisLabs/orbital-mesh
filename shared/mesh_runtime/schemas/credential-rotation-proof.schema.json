{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesh.local/contracts/credential-rotation-proof.schema.json",
  "title": "CredentialRotationProof",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "connector_id",
    "service_account_ref",
    "credential_mode",
    "rotated_at",
    "previous_secret_ref",
    "new_secret_ref",
    "previous_secret_revoked",
    "rotation_ticket_ref",
    "operator_id",
    "evidence_refs",
    "secret_material_absent",
    "break_glass_used",
    "break_glass_recorded"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["mesh.credential_rotation_proof.v1"]
    },
    "generated_at": { "type": "string" },
    "connector_id": { "type": "string" },
    "service_account_ref": { "type": "string" },
    "credential_mode": { "type": "string" },
    "rotated_at": { "type": "string" },
    "previous_secret_ref": { "type": "string" },
    "new_secret_ref": { "type": "string" },
    "previous_secret_revoked": { "type": "boolean" },
    "rotation_ticket_ref": { "type": "string" },
    "operator_id": { "type": "string" },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "secret_material_absent": { "type": "boolean" },
    "break_glass_used": { "type": "boolean" },
    "break_glass_recorded": { "type": "boolean" }
  }
}
