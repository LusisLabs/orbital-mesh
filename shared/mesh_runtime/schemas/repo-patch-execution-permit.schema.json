{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mesh.repo_patch_execution_permit.v1",
  "type": "object",
  "required": [
    "schema_version",
    "transaction_version",
    "permit_id",
    "authority_scope",
    "issuer",
    "executor_audience",
    "tenant",
    "mesh_run_id",
    "mesh_action_id",
    "action_kind",
    "authority_nonce",
    "idempotency_key",
    "hsai_request_digest",
    "hsai_decision_digest",
    "candidate_payload_digest",
    "action_proposal_digest",
    "evidence_packet_digest",
    "mesh_policy_id",
    "policy_snapshot_digest",
    "canonical_actuation_payload_digest",
    "repo_path",
    "target_path",
    "target_preimage_digest",
    "target_postimage_digest",
    "requested_claims",
    "accepted_claims",
    "explicit_nonclaims",
    "enforced_nonclaims",
    "expected_ledger_tip_before",
    "issued_at",
    "not_before",
    "expires_at",
    "authority_entry_digest",
    "ledger_tip_after",
    "permit_digest",
    "authorization_proof"
  ],
  "properties": {
    "schema_version": { "const": "mesh.repo_patch_execution_permit.v1" },
    "transaction_version": { "const": "mesh.repo_patch_execution_transaction.v1" },
    "permit_id": { "type": "string", "minLength": 8 },
    "authority_scope": { "const": "local_disposable_repo_patch_only" },
    "issuer": { "type": "string", "minLength": 1 },
    "executor_audience": { "type": "string", "minLength": 1 },
    "tenant": { "type": "string", "minLength": 1 },
    "mesh_run_id": { "type": "string", "minLength": 1 },
    "mesh_action_id": { "type": "string", "minLength": 1 },
    "action_kind": { "const": "repo_patch" },
    "authority_nonce": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "hsai_request_digest": { "$ref": "#/$defs/digest" },
    "hsai_decision_digest": { "$ref": "#/$defs/digest" },
    "candidate_payload_digest": { "$ref": "#/$defs/digest" },
    "action_proposal_digest": { "$ref": "#/$defs/digest" },
    "evidence_packet_digest": { "$ref": "#/$defs/digest" },
    "mesh_policy_id": { "type": "string", "minLength": 1 },
    "policy_snapshot_digest": { "$ref": "#/$defs/digest" },
    "canonical_actuation_payload_digest": { "$ref": "#/$defs/digest" },
    "repo_path": { "type": "string", "minLength": 1 },
    "target_path": { "type": "string", "minLength": 1 },
    "target_preimage_digest": { "$ref": "#/$defs/digest" },
    "target_postimage_digest": { "$ref": "#/$defs/digest" },
    "requested_claims": { "type": "array", "items": { "type": "string" } },
    "accepted_claims": { "type": "array", "items": { "type": "string" } },
    "explicit_nonclaims": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "enforced_nonclaims": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "expected_ledger_tip_before": { "$ref": "#/$defs/digest" },
    "issued_at": { "type": "string", "format": "date-time" },
    "not_before": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "authority_entry_digest": { "$ref": "#/$defs/digest" },
    "ledger_tip_after": { "$ref": "#/$defs/digest" },
    "permit_digest": { "$ref": "#/$defs/digest" },
    "authorization_proof": {
      "type": "object",
      "required": [
        "signing_profile",
        "algorithm",
        "key_id",
        "signature",
        "payload_sha256",
        "status",
        "verifier"
      ],
      "properties": {
        "signing_profile": { "const": "mesh-repo-patch-execution-permit-hmac-sha256-v1" },
        "algorithm": { "const": "hmac-sha256" },
        "key_id": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "status": { "const": "verified" },
        "verifier": { "const": "orbital_mesh_hmac_sha256_v1" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
