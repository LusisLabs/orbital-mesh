      "type": "string",
      "enum": ["postgres", "file"]
    },
    "run_count": { "type": "integer" },
    "concurrent_operators": { "type": "integer" },
    "worker_count": { "type": "integer" },
    "queue_size": { "type": "integer" },
    "max_queue_depth": { "type": "integer" },
    "rejected_runs": { "type": "integer" },
    "tenant_quota_enforced": { "type": "boolean" },
    "target_lock_conflicts_observed": { "type": "boolean" },
    "cancellation_exercised": { "type": "boolean" },
    "stuck_run_recovery_exercised": { "type": "boolean" },
    "backpressure_observed": { "type": "boolean" },
    "p95_admission_latency_ms": { "type": "number" },
    "p95_event_persistence_latency_ms": { "type": "number" },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "raw_secret_material_present": { "type": "boolean" }
  },
  "additionalProperties": false
}
