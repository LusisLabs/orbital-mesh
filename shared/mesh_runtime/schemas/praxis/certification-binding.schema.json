{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesh.local/contracts/praxis/certification-binding.schema.json",
  "title": "PraxisCertificationBinding",
  "type": "object",
  "required": [
    "schema_version",
    "binding_id",
    "created_at",
    "generated_contract_id",
    "security_evidence_id",
    "acp_session_id",
    "mesh_connector_certification_version",
    "connector_id",
    "tool_bindings",
    "authority",
    "revocation"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["praxis.certification_binding.v1"]
    },
    "binding_id": { "type": "string" },
    "created_at": { "type": "string" },
    "generated_contract_id": { "type": "string" },
    "security_evidence_id": { "type": "string" },
    "acp_session_id": { "type": "string" },
    "mesh_connector_certification_version": {
      "type": "string",
      "enum": ["mesh.connector_certification.v1"]
    },
    "connector_id": { "type": "string" },
    "tool_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "tool_candidate_id",
          "requested_scope",
          "mutation_class",
          "certification_result",
          "allowed_scopes",
          "readiness_blockers",
          "evidence_refs"
        ],
        "additionalProperties": false,
        "properties": {
          "tool_candidate_id": { "type": "string" },
          "requested_scope": { "type": "string" },
          "mutation_class": {
            "type": "string",
            "enum": ["read_only", "idempotent_write", "mutation", "destructive_mutation"]
          },
          "certification_result": {
            "type": "string",
            "enum": ["denied", "read_only", "approval_required", "staging_ready"]
          },
          "allowed_scopes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "readiness_blockers": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "required": [
        "mesh_owns_policy",
        "mesh_owns_certification",
        "mesh_owns_approval",
        "mesh_owns_audit",
        "mesh_owns_bounded_execution",
        "mesh_owns_revocation",
        "akto_grants_authority",
        "acp_grants_runtime_authority",
        "generated_mcp_is_candidate_until_certified"
      ],
      "additionalProperties": false,
      "properties": {
        "mesh_owns_policy": {
          "type": "boolean",
          "enum": [true]
        },
        "mesh_owns_certification": {
          "type": "boolean",
          "enum": [true]
        },
        "mesh_owns_approval": {
          "type": "boolean",
          "enum": [true]
        },
        "mesh_owns_audit": {
          "type": "boolean",
          "enum": [true]
        },
        "mesh_owns_bounded_execution": {
          "type": "boolean",
          "enum": [true]
        },
        "mesh_owns_revocation": {
          "type": "boolean",
          "enum": [true]
        },
        "akto_grants_authority": {
          "type": "boolean",
          "enum": [false]
        },
        "acp_grants_runtime_authority": {
          "type": "boolean",
          "enum": [false]
        },
        "generated_mcp_is_candidate_until_certified": {
          "type": "boolean",
          "enum": [true]
        }
      }
    },
    "revocation": {
      "type": "object",
      "required": ["revocable", "deactivation_required", "revocation_ref"],
      "additionalProperties": false,
      "properties": {
        "revocable": {
          "type": "boolean",
          "enum": [true]
        },
        "deactivation_required": {
          "type": "boolean",
          "enum": [true]
        },
        "revocation_ref": { "type": "string" }
      }
    }
  }
}
