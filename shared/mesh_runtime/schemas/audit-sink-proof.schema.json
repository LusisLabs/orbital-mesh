{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesh.local/contracts/audit-sink-proof.schema.json",
  "title": "AuditSinkProof",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "connector_id",
    "sink_id",
    "sink_state",
    "destination_uri",
    "append_only",
    "run_export_sha256",
    "merkle_root",
    "latest_event_id",
    "event_count",
    "receipt",
    "credential_boundary",
    "retention_days",
    "rotation_evidence_ref",
    "break_glass_recording_required",
    "break_glass_drill_recorded"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["mesh.audit_sink_proof.v1"]
    },
    "generated_at": { "type": "string" },
    "connector_id": { "type": "string" },
    "sink_id": { "type": "string" },
    "sink_state": {
      "type": "string",
      "enum": ["pilot-ready", "production-ready"]
    },
    "destination_uri": { "type": "string" },
    "append_only": { "type": "boolean" },
    "run_export_sha256": { "type": "string" },
    "merkle_root": { "type": "string" },
    "latest_event_id": { "type": "string" },
    "event_count": { "type": "integer" },
    "receipt": {
      "type": "object",
      "required": ["receipt_id", "received_at", "sink_sequence"],
      "additionalProperties": false,
      "properties": {
        "receipt_id": { "type": "string" },
        "received_at": { "type": "string" },
        "sink_sequence": { "type": "integer" }
      }
    },
    "credential_boundary": {
      "type": "object",
      "required": [
        "service_account_ref",
        "credential_mode",
        "runtime_secret_mount_required",
        "production_actuator_credentials_allowed",
        "repo_write_credentials_allowed"
      ],
      "additionalProperties": false,
      "properties": {
        "service_account_ref": { "type": "string" },
        "credential_mode": { "type": "string" },
        "runtime_secret_mount_required": { "type": "boolean" },
        "production_actuator_credentials_allowed": { "type": "boolean" },
        "repo_write_credentials_allowed": { "type": "boolean" }
      }
    },
    "retention_days": { "type": "integer" },
    "rotation_evidence_ref": { "type": "string" },
    "break_glass_recording_required": { "type": "boolean" },
    "break_glass_drill_recorded": { "type": "boolean" }
  }
}
