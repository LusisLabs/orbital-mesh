{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesh.local/contracts/hsai-admission-request-v2.schema.json",
  "title": "HsaiAdmissionRequestV2",
  "type": "object",
  "required": [
    "schema_version",
    "mesh_run_id",
    "mesh_action_id",
    "action_kind",
    "actor_ref",
    "mesh_policy_id",
    "action_proposal_digest",
    "candidate_payload_digest",
    "evidence_packet_digest",
    "attestation_refs",
    "requested_claims",
    "explicit_nonclaims",
    "created_at",
    "candidate_payload",
    "pre_execution_evidence"
  ],
  "properties": {
    "schema_version": { "enum": ["mesh.hsai_admission_request.v2"] },
    "mesh_run_id": { "type": "string" },
    "mesh_action_id": { "type": "string" },
    "action_kind": { "enum": ["repo_patch"] },
    "actor_ref": { "$ref": "#/$defs/actor_ref" },
    "mesh_policy_id": { "type": "string" },
    "action_proposal_digest": { "$ref": "#/$defs/digest" },
    "candidate_payload_digest": { "$ref": "#/$defs/digest" },
    "evidence_packet_digest": { "$ref": "#/$defs/digest" },
    "attestation_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "digest"],
        "properties": {
          "kind": { "type": "string" },
          "digest": { "$ref": "#/$defs/digest" }
        },
        "additionalProperties": false
      }
    },
    "requested_claims": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "explicit_nonclaims": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "created_at": { "type": "string" },
    "candidate_payload": {
      "type": "object",
      "required": [
        "decision_id",
        "trigger_id",
        "decision_type",
        "autonomy_tier",
        "summary",
        "reasoning",
        "expected_outcome",
        "risk",
        "confidence",
        "execution_plan"
      ],
      "properties": {
        "decision_id": { "type": "string" },
        "trigger_id": { "type": "string" },
        "decision_type": { "enum": ["investigate_and_patch"] },
        "autonomy_tier": { "type": "string" },
        "summary": { "type": "string" },
        "reasoning": { "type": "object" },
        "expected_outcome": { "type": "object" },
        "risk": { "type": "object" },
        "confidence": { "type": "number" },
        "execution_plan": {
          "type": "object",
          "required": ["system", "action", "parameters", "rollback_plan"],
          "properties": {
            "system": { "enum": ["repo_patch_service"] },
            "action": { "enum": ["investigate_and_patch"] },
            "parameters": {
              "type": "object",
              "required": [
                "repo_path",
                "allowed_paths",
                "protected_paths",
                "patch_template",
                "test_commands",
                "mesh_run_id",
                "mesh_action_id",
                "mesh_policy_id",
                "actor_ref"
              ],
              "properties": {
                "repo_path": { "type": "string" },
                "allowed_paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "protected_paths": { "type": "array", "items": { "type": "string" } },
                "patch_template": {
                  "type": "object",
                  "required": ["target_file", "find", "replace"],
                  "properties": {
                    "target_file": { "type": "string" },
                    "find": { "type": "string" },
                    "replace": { "type": "string" }
                  },
                  "additionalProperties": false
                },
                "test_commands": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "array", "minItems": 1, "items": { "type": "string" } }
                },
                "mesh_run_id": { "type": "string" },
                "mesh_action_id": { "type": "string" },
                "mesh_policy_id": { "type": "string" },
                "actor_ref": { "$ref": "#/$defs/actor_ref" }
              },
              "additionalProperties": false
            },
            "rollback_plan": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "pre_execution_evidence": {
      "type": "object",
      "required": [
        "schema_version",
        "decision_id",
        "evaluation_id",
        "evaluation_passed",
        "final_recommendation",
        "blocking_reasons",
        "stage_results",
        "stage_results_digest",
        "preflight_receipt"
      ],
      "properties": {
        "schema_version": { "enum": ["mesh.repo_patch_pre_execution_evidence.v1"] },
        "decision_id": { "type": "string" },
        "evaluation_id": { "type": "string" },
        "evaluation_passed": { "type": "boolean" },
        "final_recommendation": { "type": "string" },
        "blocking_reasons": { "type": "array", "items": { "type": "string" } },
        "stage_results": { "type": "object" },
        "stage_results_digest": { "$ref": "#/$defs/digest" },
        "preflight_receipt": { "$ref": "#/$defs/preflight_receipt" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "actor_ref": {
      "type": "object",
      "required": ["actor_id", "team_id"],
      "properties": {
        "actor_id": { "type": "string" },
        "team_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "preflight_receipt": {
      "type": "object",
      "required": [
        "state_slice",
        "base_commit",
        "base_tree",
        "target_path",
        "target_preimage_digest",
        "target_postimage_digest",
        "authorized_diff_digest",
        "changed_paths",
        "test_results"
      ],
      "properties": {
        "state_slice": { "enum": ["mesh.repo_patch_disposable_worktree.v1"] },
        "base_commit": { "type": "string" },
        "base_tree": { "type": "string" },
        "target_path": { "type": "string" },
        "target_preimage_digest": { "$ref": "#/$defs/digest" },
        "target_postimage_digest": { "$ref": "#/$defs/digest" },
        "authorized_diff_digest": { "$ref": "#/$defs/digest" },
        "changed_paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "test_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["argv", "returncode", "stdout_digest", "stderr_digest"],
            "properties": {
              "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "returncode": { "type": "integer" },
              "stdout_digest": { "$ref": "#/$defs/digest" },
              "stderr_digest": { "$ref": "#/$defs/digest" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
