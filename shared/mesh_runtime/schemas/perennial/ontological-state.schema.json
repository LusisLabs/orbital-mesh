{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesh.local/contracts/perennial/ontological-state.schema.json",
  "title": "OntologicalState",
  "type": "object",
  "required": [
    "contract",
    "ontological_state_id",
    "namespace",
    "created_at",
    "schema_version",
    "entities",
    "relationships",
    "conflict_sets"
  ],
  "properties": {
    "contract": {
      "type": "string",
      "enum": ["perennial.ontological_state.v1"]
    },
    "ontological_state_id": { "type": "string" },
    "namespace": { "type": "string" },
    "created_at": { "type": "string" },
    "schema_version": { "type": "string" },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["entity_id", "entity_type", "labels", "source_refs", "confidence", "status"],
        "properties": {
          "entity_id": { "type": "string" },
          "entity_type": {
            "type": "string",
            "enum": ["service", "deployment", "host", "agent", "model", "policy", "reservoir", "owner", "control"]
          },
          "labels": { "type": "object" },
          "source_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "confidence": { "type": "number" },
          "status": {
            "type": "string",
            "enum": ["active", "disputed", "superseded"]
          }
        },
        "additionalProperties": false
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relationship_id", "subject_id", "predicate", "object_id", "evidence_refs", "confidence", "status"],
        "properties": {
          "relationship_id": { "type": "string" },
          "subject_id": { "type": "string" },
          "predicate": {
            "type": "string",
            "enum": ["owns", "deploys", "depends_on", "controls", "observes", "remediates", "stores", "governs"]
          },
          "object_id": { "type": "string" },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "confidence": { "type": "number" },
          "status": {
            "type": "string",
            "enum": ["active", "disputed", "superseded"]
          }
        },
        "additionalProperties": false
      }
    },
    "conflict_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conflict_id", "entity_or_relationship_refs", "resolution", "selected_ref"],
        "properties": {
          "conflict_id": { "type": "string" },
          "entity_or_relationship_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "resolution": {
            "type": "string",
            "enum": ["unresolved", "operator_selected", "policy_selected", "time_bounded"]
          },
          "selected_ref": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
