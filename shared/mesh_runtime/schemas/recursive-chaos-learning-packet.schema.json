{
  "title": "RecursiveChaosLearningPacket",
  "type": "object",
  "required": [
    "schema_version",
    "learning_packet_id",
    "cycle_id",
    "run_id",
    "source_packet_refs",
    "sealed_source_required",
    "mesh_brain_mode",
    "mesh_model_mode",
    "recommendations",
    "training_allowed",
    "mesh_model_training_allowed",
    "advisory_only",
    "sealed_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "enum": ["mesh.recursive_chaos.learning_packet.v1"]},
    "learning_packet_id": {"type": "string"},
    "cycle_id": {"type": "string"},
    "run_id": {"type": "string"},
    "source_packet_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "sealed_source_required": {"type": "boolean"},
    "mesh_brain_mode": {"type": "string", "enum": ["recommend_only", "training_candidate"]},
    "mesh_model_mode": {"type": "string", "enum": ["recommend_only", "training_candidate"]},
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["recommendation_type", "summary", "confidence", "evidence_refs"],
        "additionalProperties": false,
        "properties": {
          "recommendation_type": {"type": "string"},
          "summary": {"type": "string"},
          "confidence": {"type": "number"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "training_allowed": {"type": "boolean"},
    "mesh_model_training_allowed": {"type": "boolean"},
    "advisory_only": {"type": "boolean"},
    "sealed_at": {"type": "string"}
  }
}
