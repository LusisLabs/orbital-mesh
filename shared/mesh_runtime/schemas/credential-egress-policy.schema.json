{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "credential-egress-policy.schema.json",
  "title": "Mesh credential egress policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": { "const": "mesh.credential_egress_policy.v1" },
    "environment": { "type": "string" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "secret_name",
          "allowed_hosts",
          "allowed_locations",
          "sandbox_placeholder_only",
          "egress_audit_event_id"
        ],
        "properties": {
          "secret_name": { "type": "string" },
          "allowed_hosts": {
            "type": "array",
            "items": { "type": "string" }
          },
          "allowed_locations": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "header": { "type": "array", "items": { "type": "string" } },
              "query": { "type": "array", "items": { "type": "string" } },
              "path": { "type": "array", "items": { "type": "string" } }
            }
          },
          "sandbox_placeholder_only": { "type": "boolean" },
          "egress_audit_event_id": { "type": "string" }
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proxy_runtime": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "runtime",
            "proof_mode",
            "proxy_instance_id",
            "last_audit_event_id",
            "allowed_hosts",
            "sandbox_placeholder_only",
            "host_bound_substitution"
          ],
          "properties": {
            "runtime": { "enum": ["iron-proxy", "credential-egress-proxy"] },
            "proof_mode": { "const": "live_proxy_audit" },
            "proxy_instance_id": { "type": "string" },
            "last_audit_event_id": { "type": "string" },
            "allowed_hosts": { "type": "array", "items": { "type": "string" } },
            "sandbox_placeholder_only": { "type": "boolean" },
            "host_bound_substitution": { "type": "boolean" },
            "sandbox_env": { "type": "object", "additionalProperties": true }
          }
        },
        "egress_audit_events": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "agent_attempt_outputs": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "sandbox_logs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exported_artifacts": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "raw_secret_fixture_values": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
