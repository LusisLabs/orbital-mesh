{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo-patch-verifier-response-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "state_slice", "job_id", "request_digest", "status", "code",
    "verifier_uid", "runner_uid", "verifier_image_digest", "sandbox_profile_digest",
    "workspace_manifest_before", "workspace_manifest_after", "test_results",
    "authorization_proof"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "mesh.repo_patch_verifier_response.v2"},
    "state_slice": {"type": "string", "const": "mesh.repo_patch_verifier_receipt.v2"},
    "job_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "request_digest": {"$ref": "#/$defs/sha256Digest"},
    "status": {"type": "string", "enum": ["succeeded", "rejected"]},
    "code": {"type": "string", "minLength": 1, "maxLength": 128},
    "verifier_uid": {"type": "integer", "minimum": 0},
    "runner_uid": {"type": "integer", "minimum": 0},
    "verifier_image_digest": {"$ref": "#/$defs/sha256Digest"},
    "sandbox_profile_digest": {"$ref": "#/$defs/sha256Digest"},
    "workspace_manifest_before": {"$ref": "#/$defs/sha256Digest"},
    "workspace_manifest_after": {"$ref": "#/$defs/sha256Digest"},
    "test_results": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/testResult"}
    },
    "authorization_proof": {"$ref": "#/$defs/authorizationProof"}
  },
  "$defs": {
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "testResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv", "returncode", "stdout_digest", "stderr_digest", "stdout_bytes",
        "stderr_bytes", "timed_out", "output_limit_exceeded"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"type": "string", "minLength": 1, "maxLength": 8192}
        },
        "returncode": {"type": "integer"},
        "stdout_digest": {"$ref": "#/$defs/sha256Digest"},
        "stderr_digest": {"$ref": "#/$defs/sha256Digest"},
        "stdout_bytes": {"type": "integer", "minimum": 0, "maximum": 73728},
        "stderr_bytes": {"type": "integer", "minimum": 0, "maximum": 73728},
        "timed_out": {"type": "boolean"},
        "output_limit_exceeded": {"type": "boolean"}
      }
    },
    "authorizationProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signing_profile", "algorithm", "key_id", "signature", "payload_sha256",
        "public_key_pem", "status", "verifier"
      ],
      "properties": {
        "signing_profile": {
          "type": "string",
          "const": "mesh-repo-patch-verifier-receipt-ed25519-v2"
        },
        "algorithm": {"type": "string", "const": "ed25519"},
        "key_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "signature": {"type": "string", "minLength": 1, "maxLength": 256},
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "public_key_pem": {"type": "string", "minLength": 1, "maxLength": 4096},
        "status": {"type": "string", "const": "verified"},
        "verifier": {"type": "string", "const": "orbital_mesh_ed25519_v1"}
      }
    }
  }
}
