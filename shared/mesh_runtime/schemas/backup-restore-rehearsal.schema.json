{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesh.local/contracts/backup-restore-rehearsal.schema.json",
  "title": "BackupRestoreRehearsal",
  "type": "object",
  "required": [
    "schema_version",
    "rehearsal_id",
    "generated_at",
    "environment",
    "operator_id",
    "state_backend",
    "backup_ref",
    "restore_ref",
    "rpo_seconds",
    "rto_seconds",
    "measured_restore_seconds",
    "components"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["mesh.backup_restore_rehearsal.v1"]
    },
    "rehearsal_id": { "type": "string" },
    "generated_at": { "type": "string" },
    "environment": { "type": "string" },
    "operator_id": { "type": "string" },
    "state_backend": {
      "type": "string",
      "enum": ["file", "postgres"]
    },
    "backup_ref": { "type": "string" },
    "restore_ref": { "type": "string" },
    "rpo_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "rto_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "measured_restore_seconds": {
      "type": "number",
      "minimum": 0
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "component",
          "backup_uri",
          "restored",
          "sha256_before",
          "sha256_after",
          "record_count"
        ],
        "additionalProperties": false,
        "properties": {
          "component": {
            "type": "string",
            "enum": [
              "state_store",
              "vault",
              "merkle_proofs",
              "integrations_config",
              "research_artifacts"
            ]
          },
          "backup_uri": { "type": "string" },
          "restored": { "type": "boolean" },
          "sha256_before": { "type": "string" },
          "sha256_after": { "type": "string" },
          "record_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
