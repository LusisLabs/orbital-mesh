{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesh.local/contracts/trigger.schema.json",
  "title": "Trigger",
  "type": "object",
  "required": [
    "trigger_id",
    "trigger_type",
    "triggered_at",
    "environment",
    "service",
    "endpoint",
    "flag_key",
    "current_rollout_pct",
    "comparison_window",
    "segment",
    "metrics",
    "related_context"
  ],
  "properties": {
    "trigger_id": {
      "type": "string"
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "feature_flag_performance_regression",
        "kubernetes_deployment_unhealthy",
        "otel_metric_regression",
        "webhook_alert_firing"
      ]
    },
    "triggered_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "endpoint": {
      "type": "string"
    },
    "flag_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "current_rollout_pct": {
      "type": [
        "integer",
        "null"
      ]
    },
    "comparison_window": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "baseline",
        "observed"
      ],
      "properties": {
        "baseline": {
          "type": "string"
        },
        "observed": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "properties": {
        "customer_tier": {
          "type": "string"
        },
        "region": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": [
        "baseline_p95_latency_ms",
        "observed_p95_latency_ms",
        "baseline_error_rate",
        "observed_error_rate",
        "sample_size"
      ],
      "properties": {
        "baseline_p95_latency_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "observed_p95_latency_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "baseline_error_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "observed_error_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "baseline_timeout_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "observed_timeout_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "sample_size": {
          "type": [
            "integer",
            "null"
          ]
        },
        "restart_count_total": {
          "type": [
            "integer",
            "null"
          ]
        },
        "desired_replicas": {
          "type": [
            "integer",
            "null"
          ]
        },
        "available_replicas": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "related_context": {
      "type": "object",
      "required": [
        "release_id",
        "active_incidents",
        "similar_prior_cases"
      ],
      "properties": {
        "release_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "active_incidents": {
          "type": "integer"
        },
        "similar_prior_cases": {
          "type": "integer"
        },
        "rollbacks_last_24h": {
          "type": "integer"
        },
        "regressions_last_7d": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
