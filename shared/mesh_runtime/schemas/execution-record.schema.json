{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesh.local/contracts/execution-record.schema.json",
  "title": "ExecutionRecord",
  "type": "object",
  "required": [
    "execution_id",
    "decision_id",
    "started_at",
    "completed_at",
    "executor",
    "status",
    "idempotency_key",
    "applied_action",
    "external_refs"
  ],
  "properties": {
    "execution_id": {
      "type": "string"
    },
    "decision_id": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "executor": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "rejected"
      ]
    },
    "idempotency_key": {
      "type": "string"
    },
    "applied_action": {
      "type": "object",
      "required": [
        "system",
        "action",
        "parameters"
      ],
      "properties": {
        "system": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "external_refs": {
      "type": "object"
    },
    "failure": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
