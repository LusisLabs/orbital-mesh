# Dependencies / build output
node_modules/
.next/
dist/
build/
*.egg-info/
.eggs/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime state (local / Compose volume; do not commit)
.mesh-runtime-state/
.hermes-local/

# Secrets
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
# Local-demo JWT secret — generated by ``simulation/bootstrap_demo.sh``.
# Never commit. The pattern of a 32-byte hex secret in repo root is
# exactly the JWT-leak anti-pattern Mesh's policy refuses to operate near.
jwt-demo.hex

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# E2E harness output — scenario reports and server logs are per-run artifacts,
# not source. Keep them local to the operator who ran the scenario.
e2e-reports/
