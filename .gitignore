# Dependencies / build output
node_modules/
.next/
dist/
build/
target/
*.egg-info/
.eggs/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime state (local / Compose volume; do not commit)
.mesh-runtime-state
.mesh-runtime-state/
.hermes-local/
kurtosis/

# Secrets
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
# Local-demo JWT secret — generated by ``simulation/bootstrap_demo.sh``.
# Never commit. The pattern of a 32-byte hex secret in repo root is
# exactly the JWT-leak anti-pattern Mesh's policy refuses to operate near.
jwt-demo.hex

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Scratch directories. ``.tmp/`` was checked in once with rendered PRD
# artifacts + PNG diagrams; the convention is local-only scratch.
# Permanent docs belong in ``docs/`` and are committed there.
.tmp/

# Stray HTML drops at the repo root (e.g. browser "save page as" output
# committed by accident). Keeps the root clean. Specific docs that
# belong here — none today — should live under ``docs/`` instead.
/*.html

# Watch-daemon scratch state. Per-run output, not source.
watch_*/

# Local bundles / generated exports
*.zip
lusisOS-main/

# E2E harness output — scenario reports and server logs are per-run artifacts,
# not source. Keep them local to the operator who ran the scenario.
e2e-reports/
web/test-results/
web/playwright-report/
