{
  "title": "HardenedArenaPacket",
  "type": "object",
  "required": [
    "schema_version",
    "packet_id",
    "generated_at",
    "selected_profile",
    "source_refs",
    "component_graph",
    "authority_boundaries",
    "credential_classes",
    "dhi_catalog_refs",
    "blockers",
    "proof_checklist",
    "mesh_probe_plan",
    "failure_mode_curriculum",
    "cleanup_plan",
    "data_retention_plan",
    "readiness_posture"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "enum": ["mesh.hardened_arena.packet.v1"]},
    "packet_id": {"type": "string"},
    "generated_at": {"type": "string"},
    "selected_profile": {
      "type": "object",
      "required": ["profile_id", "display_name", "intended_use", "lifecycle_state", "profile_readiness_posture"],
      "additionalProperties": false,
      "properties": {
        "profile_id": {"type": "string"},
        "display_name": {"type": "string"},
        "intended_use": {"type": "string"},
        "lifecycle_state": {"type": "string"},
        "profile_readiness_posture": {"type": "string"}
      }
    },
    "source_refs": {
      "type": "object",
      "required": ["profile_registry", "catalog"],
      "additionalProperties": false,
      "properties": {
        "profile_registry": {"type": "string"},
        "catalog": {"type": "string"}
      }
    },
    "component_graph": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component_id", "display_name", "component_class", "purpose", "source", "authority_boundary", "credential_class", "mutates_state", "dependencies", "rollback_proof_requirements"],
        "additionalProperties": false,
        "properties": {
          "component_id": {"type": "string"},
          "display_name": {"type": "string"},
          "component_class": {"type": "string"},
          "purpose": {"type": "string"},
          "source": {"type": "object"},
          "authority_boundary": {"type": "string"},
          "credential_class": {"type": "string"},
          "mutates_state": {"type": "boolean"},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "rollback_proof_requirements": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "authority_boundaries": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "credential_classes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "dhi_catalog_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component_id", "dhi_slug", "catalog_match", "catalog_slug", "source_url", "proof_placeholders", "blockers"],
        "additionalProperties": false,
        "properties": {
          "component_id": {"type": "string"},
          "dhi_slug": {"type": "string"},
          "catalog_match": {"type": "boolean"},
          "catalog_slug": {"type": ["string", "null"]},
          "source_url": {"type": ["string", "null"]},
          "proof_placeholders": {"type": "object"},
          "blockers": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "blockers": {"type": "array", "items": {"type": "string"}},
    "proof_checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gate", "required", "observed", "evidence_ref"],
        "additionalProperties": false,
        "properties": {
          "gate": {"type": "string"},
          "required": {"type": "boolean"},
          "observed": {"type": "boolean"},
          "evidence_ref": {"type": ["string", "null"]}
        }
      }
    },
    "mesh_probe_plan": {"type": "object"},
    "failure_mode_curriculum": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "cleanup_plan": {"type": "object"},
    "data_retention_plan": {"type": "object"},
    "readiness_posture": {
      "type": "object",
      "required": ["status", "target_validated", "production_ready", "statement"],
      "additionalProperties": false,
      "properties": {
        "status": {"type": "string", "enum": ["profile_verified", "blocked"]},
        "target_validated": {"type": "boolean"},
        "production_ready": {"type": "boolean"},
        "statement": {"type": "string"}
      }
    }
  }
}
