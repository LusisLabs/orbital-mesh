{
  "name": "orbital-mesh-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "contracts:generate": "python3 ../scripts/generate_control_plane_contracts.py",
    "contracts:check": "python3 ../scripts/generate_control_plane_contracts.py --check",
    "dev": "vite",
    "lint": "npm run contracts:check && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "build": "npm run contracts:check && npm run typecheck && vite build",
    "test": "vitest run",
    "test:e2e": "bash ../scripts/e2e_ui_operator.sh",
    "test:e2e:playwright": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.38",
    "@xyflow/react": "^12.8.6",
    "lucide-react": "^0.562.0",
    "react": "^18.3.1",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
