{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesh.local/contracts/remediation-plan.schema.json",
  "title": "RemediationPlan",
  "type": "object",
  "required": [
    "plan_id",
    "trigger_id",
    "diagnosis_id",
    "plan_type",
    "autonomy_tier",
    "goal",
    "confidence",
    "risk",
    "steps",
    "stop_conditions",
    "human_handoff_conditions"
  ],
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "trigger_id": {
      "type": "string"
    },
    "diagnosis_id": {
      "type": "string"
    },
    "plan_type": {
      "type": "string",
      "enum": [
        "no_action",
        "single_step_remediation",
        "multi_step_remediation",
        "escalate"
      ]
    },
    "autonomy_tier": {
      "type": "string",
      "enum": [
        "autonomous",
        "approval_required",
        "escalated"
      ]
    },
    "goal": {
      "type": "string"
    },
    "primary_hypothesis_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "risk": {
      "type": "object",
      "required": [
        "level",
        "blast_radius"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "blast_radius": {
          "type": "string"
        },
        "customer_impact_if_wrong": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step_id",
          "category",
          "description"
        ],
        "properties": {
          "step_id": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "feature_flag_change",
              "traffic_shift",
              "config_revert",
              "service_restart",
              "incident_open",
              "customer_intervention",
              "human_approval"
            ]
          },
          "description": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "run_if": {
            "type": [
              "string",
              "null"
            ]
          },
          "system": {
            "type": [
              "string",
              "null"
            ]
          },
          "action": {
            "type": [
              "string",
              "null"
            ]
          },
          "parameters": {
            "type": "object"
          },
          "success_checkpoint": {
            "type": [
              "object",
              "null"
            ]
          },
          "rollback": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_handoff_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
