{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesh.local/contracts/execution-record.schema.json",
  "title": "ExecutionRecord",
  "type": "object",
  "required": [
    "execution_id",
    "plan_id",
    "status",
    "started_at",
    "executor",
    "step_history"
  ],
  "properties": {
    "execution_id": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "executor": {
      "type": "string"
    },
    "step_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step_id",
          "status"
        ],
        "properties": {
          "step_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "idempotency_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "external_refs": {
            "type": [
              "object",
              "null"
            ]
          },
          "checkpoint_result": {
            "type": [
              "object",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "failure": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
