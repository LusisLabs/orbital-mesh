{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesh.local/contracts/diagnosis.schema.json",
  "title": "Diagnosis",
  "type": "object",
  "required": [
    "diagnosis_id",
    "trigger_id",
    "summary",
    "affected_scope",
    "hypotheses",
    "candidate_remediations"
  ],
  "properties": {
    "diagnosis_id": {
      "type": "string"
    },
    "trigger_id": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "affected_scope": {
      "type": "object",
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "customer_segments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blast_radius": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "hypothesis_id",
          "statement",
          "confidence",
          "supporting_evidence",
          "conflicting_evidence"
        ],
        "properties": {
          "hypothesis_id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "supporting_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conflicting_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "candidate_remediations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
