# CPU-only LatentMAS for Docker Desktop (Apple Silicon / amd64) where NVIDIA GPU pass-through
# is unavailable. Metal/MPS is macOS-only and does not apply inside Linux containers.
FROM python:3.11-slim-bookworm

WORKDIR /workspace/mesh-intelligence

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/cache/huggingface \
    TRANSFORMERS_CACHE=/cache/huggingface \
    HF_DATASETS_CACHE=/cache/huggingface \
    MESH_LATENTMAS_URL=http://0.0.0.0:8791

RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential git \
  && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir --upgrade pip \
  && python -m pip install --no-cache-dir \
    torch --index-url https://download.pytorch.org/whl/cpu \
  && python -m pip install --no-cache-dir transformers accelerate datasets tqdm numpy

COPY shared ./shared
COPY mesh_brain ./mesh_brain
COPY services ./services
COPY latent-mesh ./latent-mesh

EXPOSE 8791

CMD ["python", "-m", "services.orchestrator.latentmas_server"]
